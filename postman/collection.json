        {
          "id": "11b11e71-8f16-4903-a86f-832c82eb8642",
          "name": "List the calling user's favorites",
          "request": {
            "name": "List the calling user's favorites",
            "description": {
              "content": "Returns everything the calling user has favorited, most recently\nfavorited first. An item discontinued in the catalog after it was\nfavorited is still listed, with `available: false` — the availability\nflag is read live from the catalog, not copied at favorite-time.\n\nAn empty list is a normal response: `favorites` is `[]`, never `null`.\n\nTaking no sort or filter parameters is deliberate for this pass;\n`created_at` is retained so a later pass can add them without a\nmigration.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "favorites"
