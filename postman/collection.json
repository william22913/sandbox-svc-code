          "name": "Favorite an item",
          "request": {
            "name": "Favorite an item",
            "description": {
              "content": "Adds an item to the calling user's favorites. Favoriting an item that is\nalready favorited succeeds and changes nothing (`already_favorited:\ntrue`). Fails with 422 when the user already holds 500 favorites —\nnothing is inserted and no existing favorite is evicted. Answers 404\nwhen the item does not exist in the catalog.\n",
              "type": "text/plain"
            },
            "url": {
