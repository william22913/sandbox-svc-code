        {
          "name": "__feat003 Export favorites as CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/csv"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/favorites/export?page=2&category=Office",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "favorites",
                "export"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2",
                  "disabled": false
                },
                {
                  "key": "category",
                  "value": "Office",
                  "disabled": false
                }
              ],
              "variable": []
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{apiKeyUser1}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "description": "User 1 has five favorites, seeded to exercise quoting, an embedded newline, a comma, doubled quotes, a non-ASCII note, a discontinued item, an integer price and formula neutralisation. Public request inputs that are named in the cases but not supported by the route (`page`, `category`) must change nothing. The body is asserted byte for byte apart from the BOM, which is asserted as the first three bytes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200))",
                  "pm.test('Content-Type is bare text/csv, no charset parameter', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.eql('text/csv')",
                  "})",
                  "pm.test('Content-Disposition is a quoted attachment filename', () => {",
                  "  const value = pm.response.headers.get('Content-Disposition') || ''",
                  "  pm.expect(value).to.match(/^attachment; filename=\"favorites-\\d+-\\d{4}-\\d{2}-\\d{2}\\.csv\"$/)",
                  "})",
                  "pm.test('Cache-Control is no-store', () => {",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store')",
                  "})",
                  "pm.test('file starts with the UTF-8 BOM', () => {",
                  "  const hex = Buffer.from(pm.response.stream).toString('hex').slice(0, 6)",
                  "  pm.expect(hex).to.eql('efbbbf')",
                  "})",
                  "pm.test('body is the header plus every row, newest first', () => {",
                  "  const expected = \"item_id,name,category,price,available,favorited_at,note\\r\\n103,Pen,,0,Tersedia,2026-04-11,Café — 🎁\\r\\n102,'=cmd|calc,Office,1500,Tidak Tersedia,2026-04-10,'=1+1\\r\\n101,\\\"Notebook, A5\\\",Office,19.99,Tersedia,2026-04-09,Buy more\\r\\n104,\\\"Line1\\nLine2\\\",Misc,1234.5678,Tersedia,2026-04-01,\\r\\n105,\\\"He said \\\"\\\"hi\\\"\\\", twice\\\",,7.5,Tersedia,2026-03-05,\\r\\n\"",
                  "  const body = pm.response.text().replace(/^\\uFEFF/, '')",
                  "  pm.expect(body).to.eql(expected)",
                  "})"
                ]
              }
            }
          ]
        },
