# Copy to .env and override what you need. Every key below has a default in
# config/config.go, so the service boots with this file empty — the defaults are
# listed here so a deployment can see what it is inheriting.
#
# Names are envconfig's derivation from the config structs and the prefix
# "sandbox_svc": <PREFIX>_<SECTION>_<FIELD>.
#
# Never commit real secrets. This file is a template.

# ---- log ----
SANDBOX_SVC_LOG_LEVEL=1

# ---- server ----
SANDBOX_SVC_SERVER_PORT=8080
SANDBOX_SVC_SERVER_VERSION=1.0.0
SANDBOX_SVC_SERVER_RESOURCE_ID=sandbox-svc
SANDBOX_SVC_SERVER_APPLICATION=sandbox-svc
SANDBOX_SVC_SERVER_TEMP=./temp

# ---- postgresql ----
SANDBOX_SVC_POSTGRESQL_HOST=localhost
SANDBOX_SVC_POSTGRESQL_PORT=5432
SANDBOX_SVC_POSTGRESQL_USERNAME=postgres
SANDBOX_SVC_POSTGRESQL_PASSWORD=postgres
SANDBOX_SVC_POSTGRESQL_DBNAME=sandbox_svc
SANDBOX_SVC_POSTGRESQL_SSLMODE=disable
SANDBOX_SVC_POSTGRESQL_DEFAULTSCHEMA=public
SANDBOX_SVC_POSTGRESQL_MAXOPENCONNECTION=25
SANDBOX_SVC_POSTGRESQL_MAXIDLECONNECTION=25

# ---- redis ----
SANDBOX_SVC_REDIS_HOST=localhost
SANDBOX_SVC_REDIS_PORT=6379
SANDBOX_SVC_REDIS_DB=0
SANDBOX_SVC_REDIS_PASSWORD=
SANDBOX_SVC_REDIS_USERNAME=
SANDBOX_SVC_REDIS_MAX_RETRIES=3

# ---- token ----
SANDBOX_SVC_TOKEN_FIXED_INTERNAL_TOKEN=sandbox-svc-fixed-token
SANDBOX_SVC_TOKEN_INTERNAL_KEY=sandbox-svc-internal-key

# ---- credentials ----
SANDBOX_SVC_CREDENTIALS_CLIENT_ID=sandbox-svc

# ---- authorization_api ----
# Only consulted by UserAccessValidator on a Redis token cache-miss. The sandbox
# seed pre-populates the token key, so leaving these empty is fine locally.
SANDBOX_SVC_AUTHORIZATION_API_HOST=
SANDBOX_SVC_AUTHORIZATION_API_ROLE_MAPPING=
